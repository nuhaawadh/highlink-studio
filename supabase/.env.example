# أسرار Edge Functions — تُحفظ محليًا في supabase/.env.local وفي الإنتاج عبر: supabase secrets set --env-file supabase/.env.local
# لا تُضاف أبدًا إلى الواجهة ولا إلى git.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
REPLICATE_API_TOKEN=
# من GET https://api.replicate.com/v1/webhooks/default/secret (يبدأ بـwhsec_) — يُجلب ويُلحَق تلقائيًا عند رفع الأسرار
REPLICATE_WEBHOOK_SECRET=
GEMINI_API_KEY=
FAL_KEY=
ANTHROPIC_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=highlink-media
MEDIA_BASE_URL=https://media.highlink.tech
PAYLINK_APP_ID=
PAYLINK_SECRET_KEY=
MOYASAR_SECRET_KEY=
WEBHOOK_SIGNING_SECRET=
# سر استدعاء وظيفة reconcile (شبكة أمان الحجوزات) — يُولَّد ويُلحَق تلقائيًا بـpush-secrets.py إن غاب
RECONCILE_SECRET=
