  "vocabulary": {
   "title": "Vocabulary",
   "anyOf": [
    {
     "items": {
      "additionalProperties": false,
      "x-fal-order-properties": [
       "word",
       "replaces"
      ],
      "title": "VocabularyEntry",
      "properties": {
       "word": {
        "minLength": 1,
        "examples": [
         "VEED",
         "TikTok"
        ],
        "maxLength": 100,
        "title": "Word",
        "type": "string",
        "description": "The correctly-spelled term. Brand names, product names, and domain jargon work best."
       },
       "replaces": {
        "title": "Replaces",
        "examples": [
         [
          "vid",
          "feed"
         ]
        ],
        "minItems": 1,
        "items": {
         "minLength": 1,
         "maxLength": 100,
         "type": "string"
        },
        "type": "array",
        "description": "Misspellings that should be replaced with `word`. Matched whole-word and case-insensitively — list each misspelling once; you don't need to enumerate casings (e.g. `['vid']` already covers `Vid`, `VID`).",
        "maxItems": 20
       }
      },
      "type": "object",
      "description": "A term auto-transcription should recognise correctly, plus its common misspellings.",
      "required": [
       "word",
       "replaces"
      ]
     },
     "type": "array",
     "maxItems": 100
    },
    {
     "type": "null"
    }
   ],
   "description": "Optional list of terms to help auto-transcription correctly recognise brand names and domain jargon that providers commonly mis-spell (e.g. \"VEED\" → \"vid\"). Ignored when srt_content / srt_file_url is set."
  },
